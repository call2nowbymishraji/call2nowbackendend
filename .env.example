PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/call2now
NODE_ENV=development

# REQUIRED in production. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start when NODE_ENV=production and this is missing or shorter than 32 characters.
# In development only, a hardcoded fallback is used so the demo can boot without config.
JWT_SECRET=change-this-secret

# Comma separated list of frontend origins allowed to call this API.
# Leave unset to use the built in list (production domain, the Netlify preview domain, localhost dev ports).
# Set this explicitly for production, e.g.
# CORS_ORIGINS=https://call2now.com,https://www.call2now.com
CORS_ORIGINS=

# Optional: real Google OAuth. /api/auth/google verifies the ID token issued by the
# browser against this client ID; without it, real Google logins fail with 401.
GOOGLE_CLIENT_ID=

# Development convenience only: when set to true, /api/auth/google trusts the { email, name }
# posted by the client, so the demo can sign in without a Google token.
# NEVER set this in a deployed environment: it lets anyone log in as anyone.
GOOGLE_DEV_LOGIN=

# Optional: SMTP for OTP emails. Without it OTP codes are printed to the server console
# and returned as `devCode` in API responses (non-production only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@call2now.in

# Optional: HTTPS mail relay (Google Apps Script web app) used first when set,
# for hosts where outbound SMTP is blocked. GAS_SECRET must match the script.
GAS_URL=
GAS_SECRET=

# Optional but REQUIRED on Render/Heroku-style hosts (ephemeral disk):
# Cloudinary connection string, e.g. cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# When set, uploaded images go to Cloudinary and only the URL is stored in MongoDB.
# When empty, images are saved to server/uploads (fine for local dev only).
CLOUDINARY_URL=
